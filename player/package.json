{
  "name": "lampac-web-player",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build",
    "build:assets": "esbuild node_modules/jassub/dist/jassub.js --bundle --format=esm --minify --outfile=../ubuntu/plugins/webplayer-assets/jassub.esm.js && cp node_modules/jassub/dist/wasm/jassub-worker.js node_modules/jassub/dist/wasm/jassub-worker.wasm node_modules/jassub/dist/wasm/jassub-worker-modern.wasm ../ubuntu/plugins/webplayer-assets/",
    "check": "svelte-check --tsconfig ./tsconfig.json"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@tsconfig/svelte": "^5.0.0",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "terser": "^5.46.0",
    "typescript": "^5.5.0",
    "vite": "^6.0.0"
  },
  "dependencies": {
    "jassub": "^2.5.6",
    "shaka-player": "^4.12.0"
  }
}
